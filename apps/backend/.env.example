# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dcc_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Email (optional for dev, use nodemailer ethereal)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@dcc.dev"

# MFA
MFA_APP_NAME="DevOps Command Center"
